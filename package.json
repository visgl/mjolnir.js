{
  "name": "mjolnir.js",
  "description": "An Event Manager",
  "version": "3.1.0",
  "type": "module",
  "keywords": [
    "hammerjs",
    "touch",
    "gesture",
    "mouse",
    "keyboard",
    "event manager"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/mjolnir.js"
  },
  "license": "MIT",
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "src",
    "dist",
    "dist.min.js"
  ],
  "scripts": {
    "bootstrap": "yarn && ocular-bootstrap",
    "build": "ocular-clean && ocular-build && npm run build-bundle",
    "build-bundle": "ocular-bundle ./src/index.ts",
    "lint": "ocular-lint",
    "cover": "ocular-test headless --coverage",
    "playwright:install": "playwright install chromium",
    "publish-prod": "ocular-publish version-only-prod",
    "publish-beta": "ocular-publish version-only-beta",
    "test": "ocular-test node headless",
    "test-browser": "ocular-test browser",
    "test-fast": "yarn lint && yarn test-node",
    "test-headless": "ocular-test headless",
    "test-node": "ocular-test node"
  },
  "pre-commit": [
    "test-fast"
  ],
  "devDependencies": {
    "@vis.gl/dev-tools": "2.0.0-alpha.6",
    "@vis.gl/ts-plugins": "2.0.0-alpha.6",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^16.0.0",
    "playwright": "^1.58.0",
    "pre-commit": "^1.2.2",
    "vitest": "^4.0.18"
  },
  "volta": {
    "node": "22.22.0",
    "yarn": "4.17.1"
  },
  "packageManager": "yarn@4.17.1+sha512.ccbfabf7d7b6b32075088be9386fb9a2e00bb6887ef07fa56effabc890a56d53da1ccc4128d62db245fcbd3961b236d75335bdf7d5320ed6eafb7588b7ad4697"
}
